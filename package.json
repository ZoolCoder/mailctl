{
  "name": "mailctl-docs",
  "private": true,
  "description": "Antora toolchain for the mailctl documentation site. Not part of the Go module.",
  "scripts": {
    "docs": "antora --fetch antora-playbook.yml",
    "docs:serve": "npx --yes http-server build/site -p 8080 -c-1",
    "ui:build": "npm --prefix web run build",
    "ui:dev": "npm --prefix web run dev"
  },
  "devDependencies": {
    "@antora/cli": "3.1.10",
    "@antora/lunr-extension": "^1.0.0-alpha.13",
    "@antora/site-generator": "3.1.10"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
