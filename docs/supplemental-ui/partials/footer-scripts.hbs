<script async src="{{{uiRootPath}}}/js/vendor/highlight.js"></script>
{{#if env.SITE_SEARCH_PROVIDER}}
{{> search-scripts}}
{{/if}}
<script>
// Theme toggle. The head script has already set data-theme; this only wires the
// button and remembers the choice.
;(function () {
  var root = document.documentElement
  var buttons = document.querySelectorAll('.zc-theme-toggle')
  if (!buttons.length) return

  function label (theme) {
    return theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme'
  }

  function sync (theme) {
    buttons.forEach(function (b) {
      b.setAttribute('aria-label', label(theme))
      b.setAttribute('title', label(theme))
    })
  }

  sync(root.getAttribute('data-theme') || 'dark')

  buttons.forEach(function (button) {
    button.addEventListener('click', function () {
      var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light'
      root.setAttribute('data-theme', next)
      sync(next)
      try { localStorage.setItem('zc-theme', next) } catch (e) { /* choice is not persisted */ }
    })
  })
})()
</script>
